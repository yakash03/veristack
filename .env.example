# VeriStack — Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit actual keys or secrets to version control.

# Server-side Google Gemini API Key (Optional)
# Used exclusively on the server via x-goog-api-key header for upgrade & CVE briefings.
# Without it, VeriStack operates cleanly using its deterministic briefing engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Session Signing Secret (Optional in local dev; strongly recommended in production)
# Used for HMAC-SHA256 signing of workspace ownership cookies.
SESSION_SECRET=replace_with_random_32_byte_hex_secret

# Upstream Public Telemetry Endpoints (Free, no key required)
OSV_API_URL=https://api.osv.dev/v1
NPM_REGISTRY_URL=https://registry.npmjs.org
OPENSFF_SCORECARD_URL=https://api.securityscorecards.dev

# Optional SQLite file path override (defaults cleanly to .data/veristack.db locally or /tmp on Vercel)
VERISTACK_DB_PATH=
